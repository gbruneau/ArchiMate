            <child xsi:type="archimate:DiagramObject" id="id-f56fb2bdfc0f4f28a9b27252993b3c60" targetConnections="id-6ab205de951144a8a62cbd81b7ce765a" textPosition="1" archimateElement="id-ec80e4f9f0fa4f60a402170c5c043dac">
              <bounds x="12" y="36" width="120" height="55"/>
